{
  "expo": {
    "name": "runagotchi_mobile",
    "slug": "runagotchi_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "runagotchimobile",
    "android": {
      "package": "com.runagotchi.mobile",
      "enableEdgeToEdge": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.runagotchi.mobile",
      "icon": "./assets/images/dog/dog_state_home.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Runagotchi uses your location to track runs",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Runagotchi uses your location to continue tracking runs while the app is in the background"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dog/dog_state_home.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Runagotchi uses your location to track runs",
          "locationAlwaysAndWhenInUsePermission": "Runagotchi uses your location to continue tracking runs while the app is in the background",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/dog/dog_state_home.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05d8940d-77ec-4c02-a815-63d1ae91a29b"
      }
    },
    "owner": "kylgkorvigajava"
  }
}
