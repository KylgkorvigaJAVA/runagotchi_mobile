{
  "expo": {
    "name": "runagotchi_mobile",
    "slug": "runagotchi_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "runagotchimobile",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Runagotchi uses your location to track runs",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Runagotchi uses your location to continue tracking runs while the app is in the background"
      }
    },
    "android": {
      "enableEdgeToEdge": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Runagotchi uses your location to track runs",
          "locationAlwaysAndWhenInUsePermission": "Runagotchi uses your location to continue tracking runs while the app is in the background",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],

      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
